# Copiar a .env y completar en tu computadora. No contiene secretos reales.
DB_HOST=
DB_PORT=3306
DB_NAME=vehiculo_iot
DB_USER=
DB_PASSWORD=
# Ruta absoluta al bundle CA de Amazon RDS. Conexión TLS con verificación.
DB_SSL_CA=
DB_TIMEOUT_SECONDS=5
# Generar DOS claves distintas de al menos 32 caracteres. No exportarlas de Postman.
API_CONTROL_KEY=
API_ADMIN_KEY=

# Activa solo cuando quieras permitir control público de este vehículo.
PUBLIC_CONTROL_ENABLED=false
PUBLIC_CONTROL_VEHICLE_ID=1

# Fausto.IA. Rellena la clave únicamente en el .env del servidor.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
FAUSTO_DAILY_LIMIT=80
